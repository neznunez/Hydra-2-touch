{
  "name": "hydra-studio-live",
  "version": "0.1.0",
  "description": "Hydra live-coding desktop instrument",
  "main": "main.js",
  "author": "Hydra Studio",
  "license": "AGPL-3.0",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "hydra-synth": "^1.3.29"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "art.hydrastudio.live",
    "productName": "Hydra Studio",
    "asar": true,
    "files": ["main.js", "preload.js", "index.html", "renderer.js", "styles.css", "scrollbar.css", "quality.css", "node_modules/hydra-synth/**/*"],
    "directories": {"output": "../../outputs/Hydra-Studio-Windows"},
    "win": {"target": "portable", "artifactName": "Hydra-Studio-${version}.exe"}
  }
}

